# Secret used to sign session cookies. Generate with: openssl rand -hex 32
FRONTDESK_SESSION_SECRET=change-me-in-production

# Where the SQLite database file lives (default: ./data/frontdesk.db)
FRONTDESK_DB_PATH=./data/frontdesk.db

# Public base URL, used for QR codes, share links and canonical tags
NEXT_PUBLIC_BASE_URL=http://localhost:3000
