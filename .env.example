# ---------------------------------------------------------------- database
# Where the SQLite file lives. Relative paths resolve against the working dir.
FRONTDESK_DB_PATH=data/frontdesk.db

# ------------------------------------------------------------------- brand
# White-label the platform. See src/config/brand.ts for everything available.
NEXT_PUBLIC_BRAND_NAME=Frontdesk
NEXT_PUBLIC_BRAND_TAGLINE=Turn interest into the first interaction.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# URL segment public pages live under: /{prefix}/{handle}
NEXT_PUBLIC_PAGE_PREFIX=p
# Set to false to drop the "Built with …" line from customer pages
NEXT_PUBLIC_SHOW_POWERED_BY=true

SUPPORT_EMAIL=hello@example.com
SUPPORT_PRIVACY_EMAIL=privacy@example.com
SUPPORT_BILLING_EMAIL=billing@example.com

# ---------------------------------------------------------------- operators
# Comma-separated emails allowed into /admin. Empty means nobody.
ADMIN_EMAILS=

# ----------------------------------------------------------------- switches
SIGNUPS_OPEN=true
SIGNUP_INVITE_ONLY=false
SIGNUP_INVITE_CODES=
# Advertise operator-featured customer pages on the marketing site
PUBLIC_DIRECTORY=true
UPLOADS_ENABLED=true
HANDLE_CHANGES=true

# One-click demo sign-in. Leave off in production — it signs anyone in as the
# demo tenant. Defaults to on outside production.
NEXT_PUBLIC_DEMO_ACCOUNT=true
DEMO_ACCOUNT_EMAIL=demo@frontdesk.app

# ------------------------------------------------------------- rate limits
# Events allowed per window, per address. Defaults in src/config/rate-limits.ts.
# Raise the signup limit when running the browser tests, which create tenants.
RATE_LIMIT_SIGNUP=5
RATE_LIMIT_LOGIN_IP=10
RATE_LIMIT_LOGIN_ACCOUNT=5
RATE_LIMIT_LEADS=5
RATE_LIMIT_UPLOADS=60
RATE_LIMIT_TRACK=120
